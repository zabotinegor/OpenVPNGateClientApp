{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell",
        "bash": "sh .github/scripts/protect-agent-git-command.sh",
        "powershell": "cmd /c .github/scripts/protect-agent-git-command.cmd",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
