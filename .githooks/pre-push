#!/bin/sh

root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -f "$root/.copilottools-source" ]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/develop)
      echo "BLOCKED: direct push or protected-ref mutation to '$remote_ref' is forbidden." >&2
      exit 1
      ;;
    refs/heads/dev)
      # Narrow exception for the release-flow archive step: allow delete and
      # recreation of dev from merged main. main, master, develop stay blocked.
      zero=0000000000000000000000000000000000000000
      # In-place updates (both SHAs non-zero = ref exists on both ends) are always blocked.
      if [ "$local_sha" != "$zero" ] && [ "$remote_sha" != "$zero" ]; then
        echo "BLOCKED: in-place update to refs/heads/dev is forbidden; only delete or fresh creation is permitted (release-flow archive step)." >&2
        exit 1
      fi
      if [ "$local_sha" = "$zero" ]; then
        # Deleting dev: an old archive ref is not enough - require an
        # archive/archive-dev-* ref at the current remote dev tip, so
        # unmerged dev work can never lose its last remote reference.
        dev_sha=$(git rev-parse origin/dev 2>/dev/null || true)
        archived_match=""
        if [ -n "$dev_sha" ]; then
          for sha in $(git for-each-ref --format='%(objectname)' 'refs/remotes/origin/archive/archive-dev-*' 2>/dev/null); do
            if [ "$sha" = "$dev_sha" ]; then
              archived_match=1
              break
            fi
          done
        fi
        if [ -z "$archived_match" ]; then
          echo "BLOCKED: deleting refs/heads/dev requires an archive/archive-dev-* ref at the current dev tip (${dev_sha:-unknown}); archive dev first (release-flow archive step)." >&2
          exit 1
        fi
      fi
      if [ "$local_sha" != "$zero" ]; then
        main_sha=$(git rev-parse origin/main 2>/dev/null || echo "")
        if [ -z "$main_sha" ] || [ "$local_sha" != "$main_sha" ]; then
          echo "BLOCKED: direct push or protected-ref mutation to '$remote_ref' is forbidden." >&2
          exit 1
        fi
      fi
      ;;
  esac

  zero=0000000000000000000000000000000000000000
  if [ "$local_sha" != "$zero" ] && [ "$remote_sha" != "$zero" ] &&
     ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "BLOCKED: non-fast-forward push is forbidden in client repositories." >&2
    exit 1
  fi
done

exit 0
