#!/bin/sh

root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -f "$root/.copilottools-source" ]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/develop)
      echo "BLOCKED: direct push or protected-ref mutation to '$remote_ref' is forbidden." >&2
      exit 1
      ;;
    refs/heads/dev)
      # Narrow exception for the release-flow archive step only.
      # Permit only delete (local_sha == zero) or fresh create (remote_sha == zero).
      # In-place updates to an existing dev ref remain blocked.
      zero=0000000000000000000000000000000000000000
      if [ "$local_sha" != "$zero" ] && [ "$remote_sha" != "$zero" ]; then
        echo "BLOCKED: in-place update to refs/heads/dev is forbidden; only delete or fresh creation is permitted (release-flow archive step)." >&2
        exit 1
      fi
      ;;
  esac

  zero=0000000000000000000000000000000000000000
  if [ "$local_sha" != "$zero" ] && [ "$remote_sha" != "$zero" ] &&
     ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "BLOCKED: non-fast-forward push is forbidden in client repositories." >&2
    exit 1
  fi
done

exit 0
