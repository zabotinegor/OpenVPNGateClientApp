#!/bin/sh
# Provision CopilotTools local-only agent assets into a newly created checkout
# or worktree. This hook is intentionally fail-soft: git checkout must not be
# blocked by network/tooling availability. The Developer Flow freshness gate
# fails closed later if provisioning could not be completed.

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$root" ] || [ -f "$root/.agenttools-source" ]; then
  exit 0
fi

# Existing worktree already has a synchronized local runtime layer. Source
# freshness is checked separately at Developer Flow startup; do not spend a
# network request on every ordinary branch checkout.
if [ -f "$root/.copilottools/asset-lock.json" ] &&
   [ -f "$root/.github/scripts/refresh-agent-assets.ps1" ]; then
  exit 0
fi

sync_script="$(dirname "$0")/trusted-runtime/sync-agent-assets.ps1"
if [ ! -f "$sync_script" ]; then
  echo "CopilotTools worktree bootstrap skipped: sync-agent-assets.ps1 is missing." >&2
  exit 0
fi
if ! command -v pwsh >/dev/null 2>&1; then
  echo "CopilotTools worktree bootstrap skipped: pwsh is unavailable." >&2
  exit 0
fi

# Checkout must never wait indefinitely for DNS/TLS, git clone or a child
# process. GNU timeout is available in Git Bash and Linux; if it is absent or
# shadowed by an incompatible executable, skip rather than run unbounded.
# Developer Flow's freshness gate will retry and fail closed later.
if ! command -v timeout >/dev/null 2>&1 ||
   ! timeout --version 2>/dev/null | grep -qi 'coreutils'; then
  echo "CopilotTools worktree bootstrap skipped: GNU timeout is unavailable." >&2
  exit 0
fi

checkout_deadline=60
# Tests/operators can reduce the deadline, but cannot raise the 60s maximum.
case "${COPILOTTOOLS_CHECKOUT_BOOTSTRAP_TIMEOUT_SECONDS:-}" in
  [1-9]|[1-5][0-9]|60) checkout_deadline="$COPILOTTOOLS_CHECKOUT_BOOTSTRAP_TIMEOUT_SECONDS" ;;
esac
if ! timeout -k 3s "${checkout_deadline}s" pwsh -NoProfile -NonInteractive -File "$sync_script" -TargetRoot "$root" >/dev/null 2>&1; then
  echo "CopilotTools worktree bootstrap timed out or failed; Developer Flow will retry and fail closed if freshness is still unproven." >&2
fi

exit 0
