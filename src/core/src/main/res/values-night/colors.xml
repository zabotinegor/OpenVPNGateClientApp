<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Gray/black palette (apply for system Dark) -->
    <color name="app_background">@color/dark_base_background</color>
    <color name="nav_bar_background">#1A1A1A</color>
    <color name="menu_icon_color">#FFFFFF</color>
    <color name="text_color_primary">#FFFFFF</color>
    <color name="text_color_secondary">#B0B0B0</color>
    <color name="text_color_tertiary">#FFFFFF</color>
    <color name="icon_color">#B0B0B0</color>
    <color name="theme_color_secondary">#FFFFFF</color>
    <color name="button_primary_background">#424242</color>

    <!-- Section: Splash -->
    <color name="splash_background_color">@color/dark_base_background</color>

    <!-- Speedometer Colors: neutral grays -->
    <!-- Hairline color for the connection-detail dividers. -->
    <color name="speedometer_arc_color">#232323</color>
    <!-- Unfilled part of the dial band: the desaturated navy groove of the reference dial,
         visible against #121212 without competing with the gradient fill. -->
    <color name="speedometer_track_color">#2A2B41</color>
    <!-- Dial face: black across most of the disc, lifting only just under the band so the
         interior reads as unlit space rather than as a plate sitting on the background. -->
    <color name="speedometer_face_center_color">#000000</color>
    <color name="speedometer_face_edge_color">#0B0B18</color>
    <!-- Progress fill: blue -> cyan -> mint, brightened for the dark background. -->
    <color name="speedometer_gradient_start">#1BA7F5</color>
    <color name="speedometer_gradient_mid">#35DCE6</color>
    <color name="speedometer_gradient_end">#55EFB4</color>
    <!-- Scale labels: bright up to the needle, muted past it. -->
    <color name="speedometer_label_active_color">@color/text_color_primary</color>
    <color name="speedometer_label_inactive_color">#6E6E82</color>
    <!-- Needle: tapered wedge shaded along its length, wide end at the rim. -->
    <color name="speedometer_needle_outer_color">#A6A6B2</color>
    <color name="speedometer_needle_inner_color">#26262E</color>
    <!-- Value readout inside the dial and the unit caption under it. -->
    <color name="speedometer_value_color">@color/text_color_primary</color>
    <color name="speedometer_unit_color">@color/text_color_secondary</color>

    <!-- Ping Colors -->
    <color name="ping_strong_color">#4CAF50</color>
    <color name="ping_medium_color">#FFB300</color>
    <color name="ping_weak_color">#E53935</color>

    <!-- Connection button dedicated colors (night) -->
    <color name="connection_button_disconnected">@color/button_primary_background</color>
    <color name="connection_button_connecting">#FFB300</color>
    <color name="connection_button_active">#E53935</color>

    <!-- TV specific -->
    <color name="background_gradient_start">@color/app_background</color>
    <color name="background_gradient_end">@color/nav_bar_background</color>
    <color name="default_background">@color/nav_bar_background</color>
    <color name="selected_background">#2F2F2F</color>
    <color name="fastlane_background">@color/nav_bar_background</color>
    <color name="search_opaque">#80FFFFFF</color>
    <color name="toolbar_nav_focus_bg">#33424242</color>

    <!-- Server selection chip states (night) -->
    <color name="server_selection_bg_default">#262626</color>
    <color name="server_selection_bg_focus">#333333</color>
    <color name="server_selection_bg_pressed">#3D3D3D</color>
    <color name="server_selection_border_default">#404040</color>
    <color name="server_selection_border_focus">#5A5A5A</color>
    <color name="server_selection_border_pressed">#6E6E6E</color>

    <!-- Loading indicator tint (night) -->
    <color name="loading_spinner_color">#5A5A5A</color>

    <!-- Switch Colors -->
    <color name="switch_thumb_checked">#FFFFFF</color>
    <color name="switch_track_checked">#4DFFFFFF</color>
    <color name="switch_thumb_unchecked">#B0B0B0</color>
    <color name="switch_track_unchecked">#4D808080</color>

    <!-- Section: Favorites section card (SUB-09) -->
    <color name="favorites_card_background">#242424</color>

    <!-- Section: Popup menu / dialog surfaces (SUB-08 defect fix) -->
    <!-- Lighter than both app_background (#121212) and nav_bar_background/colorSurface (#1A1A1A,
         used by row cards) — matches Material dark-theme elevation convention (raised = lighter)
         so the mobile favorite-toggle PopupMenu and app AlertDialogs read as distinct raised
         surfaces instead of blending into the page/list behind them. -->
    <color name="popup_menu_background">#2E2E2E</color>
    <color name="popup_menu_stroke">#3F3F3F</color>
    <color name="dialog_surface_background">#2E2E2E</color>
    <!-- DEF-5-tv-dialog-still-looks-stock defect fix: same value as popup_menu_stroke above.
         A color-only dialog_surface_background fill (identical tone to popup_menu_background)
         was not visually distinct enough on a real TV screen; reusing the same stroke tone that
         already differentiates the PopupMenu gives the AlertDialog the same proven border
         contrast against app_background (#121212) and colorSurface (#1A1A1A). -->
    <color name="dialog_surface_stroke">#3F3F3F</color>

</resources>
