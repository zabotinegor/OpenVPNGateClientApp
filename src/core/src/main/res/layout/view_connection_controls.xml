<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <!--
    Fixed-height spacer above the server-selector button. This ConstraintLayout chain is
    bottom-anchored only (server_selection_container has no top constraint), so its overall
    wrap_content height - and therefore how far above the screen bottom the details/speedometer
    area gets pushed - is driven entirely by the sum of fixed heights/margins in this chain.
    A real View here (rather than a bigger marginBottom on the speedometer, which is absorbed
    as invisible slack inside the weighted LinearLayout in view_connection_details.xml and
    never reaches the screen) is what actually opens up visible room between the speedometer
    and this button on both phone and TV.
    -->
    <View
        android:id="@+id/controls_top_spacer"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toTopOf="@+id/server_selection_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/server_selection_container"
        style="@style/Widget.OpenVPNClientGate.ServerSelectionButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:shadowColor="@color/text_color_tertiary"
        android:shadowRadius="10"
        app:layout_constraintBottom_toTopOf="@+id/pause_connection_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Japan\nTokyo" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/pause_connection_button"
        style="@style/Widget.OpenVPNClientGate.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clipToOutline="false"
        android:outlineProvider="none"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/pause_connection"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/start_connection_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_connection_button"
        style="@style/Widget.OpenVPNClientGate.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clipToOutline="false"
        android:outlineProvider="none"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/start_connection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</merge>
