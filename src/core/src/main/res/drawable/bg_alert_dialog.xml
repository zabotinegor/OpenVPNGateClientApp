<?xml version="1.0" encoding="utf-8"?>
<!-- SUB-08 defect fix: app-styled window background for FavoriteActionDialog's TV AlertDialog
     (and other app AlertDialogs sharing alertDialogTheme, e.g. MainActivityCore.showUpdateDialog).
     Plain androidx.appcompat.app.AlertDialog.Builder does not derive android:windowBackground
     from ?attr/colorSurface (that indirection is MaterialAlertDialogBuilder-only — see themes.xml
     ThemeOverlay.OpenVPNClientGate.AlertDialog doc comment), so the background is set directly
     here via the same reliable drawable pattern used for the PopupMenu's android:popupBackground:
     a dedicated ovpnDialogSurfaceBackground fill, distinct from ?attr/colorSurface (used by the
     row cards and page behind the dialog), with item_corner_radius corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/ovpnDialogSurfaceBackground" />
    <corners android:radius="@dimen/item_corner_radius" />
</shape>
