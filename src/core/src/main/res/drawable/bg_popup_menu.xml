<?xml version="1.0" encoding="utf-8"?>
<!-- App-styled background for the mobile favorite-toggle PopupMenu — dedicated
     ovpnPopupMenuBackground fill (distinct from ?attr/colorSurface, which the row cards behind
     it also use) plus a subtle stroke, with item_corner_radius corners, replacing the stock
     platform popup appearance. Wired via Widget.OpenVPNClientGate.PopupMenu's
     android:popupBackground. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/ovpnPopupMenuBackground" />
    <stroke
        android:width="1dp"
        android:color="?attr/ovpnPopupMenuStroke" />
    <corners android:radius="@dimen/item_corner_radius" />
</shape>
