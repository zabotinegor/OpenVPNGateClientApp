<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Section: Theme palette (Light) -->
    <color name="app_background">#F7F9FC</color>
    <color name="nav_bar_background">#FFFFFF</color>
    <color name="menu_icon_color">#FFFFFF</color>
    <color name="text_color_primary">#092635</color>
    <color name="text_color_secondary">#5F7384</color>
    <color name="text_color_tertiary">#FFFBF5</color>
    <color name="icon_color">#94A3B8</color>
    <color name="theme_color_secondary">#94A3B8</color>
    <color name="button_primary_background">#C9D4E2</color>
    <color name="dark_base_background">#121212</color>

    <!-- Section: Splash -->
    <color name="splash_background_color">#F7F9FC</color>

    <!-- Section: Speedometer -->
    <!-- Hairline color for the connection-detail dividers. Not the gauge's unfilled track -
         that is speedometer_track_color below. -->
    <color name="speedometer_arc_color">#E7EBF0</color>
    <color name="speedometer_progress_color">#7F93A8</color>
    <!-- Unfilled part of the dial band. Reads as a quiet groove so only the gradient fill,
         the needle and the value carry visual weight (as on the speedtest.net dial). -->
    <color name="speedometer_track_color">#DCE3ED</color>
    <!-- Dial face: radial gradient from the hub outwards, filling the disc inside the band. -->
    <color name="speedometer_face_center_color">#FFFFFF</color>
    <color name="speedometer_face_edge_color">#EAEFF6</color>
    <!-- Progress fill: blue -> cyan -> mint, remapped across whatever share of the arc is
         currently filled, so the leading edge always lands on the bright mint end. Deeper than
         the night-theme stops: the same bright tones that carry against #121212 wash out against
         a near-white face, leaving the filled/unfilled boundary hard to place. -->
    <color name="speedometer_gradient_start">#0F62D6</color>
    <color name="speedometer_gradient_mid">#0090B4</color>
    <color name="speedometer_gradient_end">#0E9E77</color>
    <!-- Scale labels: bright up to the needle, muted past it. The muted tone is held at roughly
         the same contrast against the face as its night-theme counterpart (~4:1); the previous
         #A7B2C0 measured 2.15:1 on white and read as barely-there. -->
    <color name="speedometer_label_active_color">@color/text_color_primary</color>
    <color name="speedometer_label_inactive_color">#6F7E90</color>
    <!-- Needle: tapered wedge shaded along its length, wide end at the rim. Inner (hub-side)
         stop narrowed from #C4CDDA: that tone measured ~1.6:1 contrast against
         speedometer_face_center_color, far below the ~3:1 WCAG non-text minimum, so the needle's
         hub half visually disappeared against the face in light theme (reported as "gray on
         gray" even while connected). #66738A measures ~4.8:1 against the white face center, in
         the same range as the ~5.8:1 the outer stop already achieves, so the wedge now reads as
         solid along its full length while keeping a slight taper towards the rim. (The needle's
         radius range, 0.09-0.45 * outerRadius, never reaches the track band at
         0.875-1.0 * outerRadius, so a track-color comparison doesn't apply here.) -->
    <color name="speedometer_needle_outer_color">#59667A</color>
    <color name="speedometer_needle_inner_color">#66738A</color>
    <!-- Value readout inside the dial and the unit caption under it. -->
    <color name="speedometer_value_color">@color/text_color_primary</color>
    <color name="speedometer_unit_color">@color/text_color_secondary</color>

    <!-- Section: Ping -->
    <color name="ping_strong_color">#00FF00</color>
    <color name="ping_medium_color">#FFFF00</color>
    <color name="ping_weak_color">#FF0000</color>

    <!-- Section: TV-specific colors -->
    <color name="background_gradient_start">@color/app_background</color>
    <color name="background_gradient_end">@color/nav_bar_background</color>
    <color name="default_background">@color/nav_bar_background</color>
    <color name="selected_background">@color/button_primary_background</color>
    <color name="tv_focus_overlay_light">#4DC9D4E2</color>
    <color name="tv_focus_overlay_dark">#1FFFFFFF</color>

    <!-- Section: Connection button -->
    <color name="connection_button_disconnected">@color/button_primary_background</color>
    <color name="connection_button_connecting">#E0B85F</color>
    <color name="connection_button_active">#C95A57</color>
    <color name="fastlane_background">@color/nav_bar_background</color>
    <color name="search_opaque">#80FFFFFF</color>

    <!-- Section: Toolbar nav focus (TV) -->
    <color name="toolbar_nav_focus_bg">@color/selected_background</color>

    <!-- Section: Server selection chips -->
    <color name="server_selection_bg_default">#00000000</color>
    <color name="server_selection_bg_focus">@color/selected_background</color>
    <color name="server_selection_bg_pressed">@color/selected_background</color>
    <color name="server_selection_border_default">#092635</color>
    <color name="server_selection_border_focus">#2F5C75</color>
    <color name="server_selection_border_pressed">#2F5C75</color>

    <!-- Section: Loading indicator -->
    <color name="loading_spinner_color">@color/speedometer_progress_color</color>

    <!-- Section: Switch Colors -->
    <color name="switch_thumb_checked">@color/button_primary_background</color>
    <color name="switch_track_checked">#80C9D4E2</color>
    <color name="switch_thumb_unchecked">#F1F1F1</color>
    <color name="switch_track_unchecked">#80B0B0B0</color>

    <!-- Section: Favorites section card (SUB-09) -->
    <!-- Darkened from #EEF2F7 for adequate contrast against app_background (#F7F9FC); manual QA
         found the original tone visually indistinguishable from the page background in light theme. -->
    <color name="favorites_card_background">#DBE3EC</color>

    <!-- Section: Popup menu / dialog surfaces (SUB-08 defect fix) -->
    <!-- Distinct from both app_background (#F7F9FC) and nav_bar_background/colorSurface (#FFFFFF,
         used by row cards) so the mobile favorite-toggle PopupMenu and app AlertDialogs read as
         raised surfaces instead of blending into the page/list behind them. -->
    <color name="popup_menu_background">#DBE3EC</color>
    <color name="popup_menu_stroke">#B9C4D1</color>
    <color name="dialog_surface_background">#DBE3EC</color>
    <!-- DEF-5-tv-dialog-still-looks-stock defect fix: same value as popup_menu_stroke above.
         A color-only dialog_surface_background fill (identical tone to popup_menu_background)
         was not visually distinct enough on a real TV screen; reusing the same stroke tone that
         already differentiates the PopupMenu gives the AlertDialog the same proven border
         contrast against app_background (#F7F9FC) and colorSurface (#FFFFFF). -->
    <color name="dialog_surface_stroke">#B9C4D1</color>

</resources>
