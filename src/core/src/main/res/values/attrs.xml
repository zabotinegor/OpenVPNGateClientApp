<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SpeedometerView">
        <attr name="arcColor" format="color" />
        <attr name="progressColor" format="color" />
        <attr name="speedTextColor" format="color" />
        <attr name="subtitleTextColor" format="color" />
        <attr name="arcWidth" format="dimension" />
        <attr name="speedTextSize" format="dimension" />
        <attr name="subtitleTextSize" format="dimension" />
    </declare-styleable>

    <!-- Section: App theme attributes (centralized color tokens for app-specific parts) -->
    <attr name="ovpnNavBarColor" format="color" />
    <attr name="ovpnSpeedometerArcColor" format="color" />
    <attr name="ovpnSpeedometerProgressColor" format="color" />
    <attr name="ovpnSpeedometerTextColor" format="color" />
    <attr name="ovpnFocusableStateListAnimator" format="reference" />
    <!-- SUB-09: fill color for the pinned Favorites section card (colorSurface-variant tone,
         distinct from ?attr/colorSurface so the card reads as a raised block behind the
         colorSurface row cards). -->
    <attr name="ovpnFavoritesCardBackground" format="color" />
    <!-- SUB-08 defect fix: background for the mobile favorite-toggle PopupMenu. Must be
         distinct from ?attr/colorSurface (used by row cards) so the popup reads as a raised
         surface instead of blending into the list behind it. -->
    <attr name="ovpnPopupMenuBackground" format="color" />
    <!-- SUB-08 defect fix: subtle border color for the PopupMenu background, adding definition
         against the page/list without relying on elevation shadow alone. -->
    <attr name="ovpnPopupMenuStroke" format="color" />
    <!-- SUB-08 defect fix: background for app AlertDialogs (TV FavoriteActionDialog,
         MainActivityCore.showUpdateDialog, etc.), distinct from ?attr/colorSurface so dialogs
         read as raised surfaces instead of blending into the page/background behind them.
         Concrete, non-self-referencing value (see round-1/round-3 review history for why a
         self-referencing colorSurface item was removed from the AlertDialog theme overlay). -->
    <attr name="ovpnDialogSurfaceBackground" format="color" />
    <!-- DEF-5-tv-dialog-still-looks-stock defect fix: border color for app AlertDialogs (TV
         FavoriteActionDialog, MainActivityCore.showUpdateDialog, etc.), mirroring
         ovpnPopupMenuStroke above. A color-only background fill was judged insufficient on a
         real TV screen (window dim/scrim behind the dialog); a visible stroke gives the same
         "distinct raised surface" differentiation the PopupMenu already has. -->
    <attr name="ovpnDialogSurfaceStroke" format="color" />
</resources>
